{
  "expo": {
    "name": "WritersNook",
    "slug": "writersnook-mobile",
    "version": "1.0.0",
    "scheme": "writersnook",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "editor-web/dist/index.html"
    ],
    "plugins": [
      "expo-dev-client",
      "expo-share-intent",
      "react-native-quick-crypto",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "WritersNook uses your camera to scan a pairing QR code from your other device.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f7efe1",
          "dark": {
            "backgroundColor": "#1a1713"
          }
        }
      ]
    ],
    "android": {
      "package": "com.coles.writersnook",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7efe1"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.coles.writersnook",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
