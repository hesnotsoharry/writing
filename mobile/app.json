{
  "expo": {
    "name": "WritersNook",
    "slug": "writersnook-mobile",
    "version": "0.1.0",
    "scheme": "writersnook",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "editor-web/dist/index.html"
    ],
    "plugins": [
      "expo-dev-client",
      "expo-share-intent",
      "react-native-quick-crypto",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "WritersNook uses your camera to scan a pairing QR code from your other device.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "android": {
      "package": "com.coles.writersnook",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.coles.writersnook"
    }
  }
}
