{
  "expo": {
    "name": "WritersNook",
    "slug": "writersnook-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-dev-client",
      "react-native-quick-crypto",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.coles.writersnook"
    },
    "ios": {
      "bundleIdentifier": "com.coles.writersnook"
    }
  }
}
