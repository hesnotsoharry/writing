{
  "name": "writersnook-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "editor-web:build": "vite build --config editor-web/vite.config.ts",
    "editor-web:watch": "vite build --watch --config editor-web/vite.config.ts",
    "test": "vitest run --config vitest.config.ts --maxWorkers=4",
    "lint": "eslint src/ editor-web/src/",
    "typecheck:native": "tsc --noEmit",
    "typecheck:editor-web": "tsc --noEmit -p editor-web/tsconfig.json",
    "typecheck": "npm run typecheck:native && npm run typecheck:editor-web",
    "prestart": "npm run editor-web:build",
    "start": "expo start --dev-client",
    "preandroid": "npm run editor-web:build",
    "android": "expo run:android",
    "eas-build-post-install": "npm run editor-web:build"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "0.4.3",
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@expo-google-fonts/literata": "0.4.3",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "js-base64": "3.7.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-quick-crypto": "1.1.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "~19.2.2",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "jsdom": "29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "7.0.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.8"
  }
}
