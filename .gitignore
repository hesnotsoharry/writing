.superpowers/
node_modules/
dist/
target/
*.log

# Local build config (Vite reads these at build time; never commit)
.env
.env.local
.env.*.local

# Eval API keys — never commit (load via --env-file=eval/.env.eval or export manually)
eval/.env.eval
# eval/runs/ holds dry-run scratch (regenerable placeholder) — gitignored.
# Real pilot/matrix evidence is preserved deliberately at live-run time (copied
# out of runs/ into a committed evidence path), not via this directory.
eval/runs/

# Local wrangler dev state (miniflare DO/cache sqlite) — regenerable, never commit
.wrangler/

# Repo-local codex CLI config (machine-local)
.codex/

# Expo local device state (regenerable)
mobile/.expo/
